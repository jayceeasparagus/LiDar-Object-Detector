cmake_minimum_required(VERSION 3.8)

project(lidar_detector_ros)

if(NOT CMAKE_CXX_STANDARD)
    set(CMAKE_CXX_STANDARD 17)
endif()

find_package(ament_cmake REQUIRED)
find_package(geometry_msgs REQUIRED)
find_package(nav_msgs REQUIRED)
find_package(rclcpp REQUIRED)
find_package(sensor_msgs REQUIRED)
find_package(tf2_ros REQUIRED)
find_package(visualization_msgs REQUIRED)

add_subdirectory(../detector_core detector_core_build EXCLUDE_FROM_ALL)

add_executable(lidar_detector_node src/lidar_detector_node.cpp)

add_executable(synthetic_scan_publisher src/synthetic_scan_publisher.cpp)

add_executable(odom_tf_broadcaster src/odom_tf_broadcaster.cpp)

add_executable(pointcloud_inspector_node
  src/pointcloud_inspector_node.cpp
)

ament_target_dependencies(lidar_detector_node rclcpp sensor_msgs visualization_msgs)

ament_target_dependencies(synthetic_scan_publisher rclcpp sensor_msgs)

ament_target_dependencies(odom_tf_broadcaster geometry_msgs nav_msgs rclcpp tf2_ros)

ament_target_dependencies(pointcloud_inspector_node
  rclcpp
  sensor_msgs
)

target_link_libraries(lidar_detector_node detector_core)

target_link_libraries(pointcloud_inspector_node
  detector_core)

install(TARGETS lidar_detector_node DESTINATION lib/${PROJECT_NAME})

install(TARGETS lidar_detector_node synthetic_scan_publisher odom_tf_broadcaster DESTINATION lib/${PROJECT_NAME})

install(TARGETS pointcloud_inspector_node DESTINATION lib/${PROJECT_NAME})

install(DIRECTORY config launch rviz worlds DESTINATION share/${PROJECT_NAME})

ament_package()