<?xml version="1.0"?>
<sdf version="1.9">
  <world name="obstacle_test_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>14 14</size></plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>14 14</size></plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four boundary walls create a 12 m by 12 m test arena. -->
    <model name="north_wall">
      <static>true</static><pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.18 0.22 0.28 1</ambient><diffuse>0.25 0.32 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.18 0.22 0.28 1</ambient><diffuse>0.25 0.32 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.2 1.0</size></box></geometry>
          <material><ambient>0.18 0.22 0.28 1</ambient><diffuse>0.25 0.32 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.2 1.0</size></box></geometry>
          <material><ambient>0.18 0.22 0.28 1</ambient><diffuse>0.25 0.32 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Ten repeatable obstacles with varied poses and dimensions. -->
    <model name="box_01">
      <static>true</static><pose>2.1 0.7 0.5 0 0 0.15</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.45 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.45 1.0</size></box></geometry>
          <material><ambient>0.70 0.15 0.12 1</ambient><diffuse>0.85 0.20 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_02">
      <static>true</static><pose>3.6 -1.4 0.35 0 0 0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.35 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 0.35 0.7</size></box></geometry>
          <material><ambient>0.12 0.45 0.75 1</ambient><diffuse>0.15 0.55 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_03">
      <static>true</static><pose>1.6 -3.2 0.65 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 0.55 1.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 1.3</size></box></geometry>
          <material><ambient>0.20 0.65 0.30 1</ambient><diffuse>0.25 0.80 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_04">
      <static>true</static><pose>-1.8 -2.5 0.3 0 0 -0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.1 0.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.1 0.5 0.6</size></box></geometry>
          <material><ambient>0.75 0.50 0.10 1</ambient><diffuse>0.95 0.65 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_05">
      <static>true</static><pose>-3.3 -0.8 0.45 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.65 1.3 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.65 1.3 0.9</size></box></geometry>
          <material><ambient>0.55 0.18 0.62 1</ambient><diffuse>0.70 0.22 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_06">
      <static>true</static><pose>-3.0 2.4 0.55 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.4 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.4 1.1</size></box></geometry>
          <material><ambient>0.10 0.62 0.62 1</ambient><diffuse>0.12 0.78 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_07">
      <static>true</static><pose>-0.8 3.5 0.4 0 0 0.65</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 1.0 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 1.0 0.8</size></box></geometry>
          <material><ambient>0.82 0.32 0.12 1</ambient><diffuse>0.95 0.40 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_08">
      <static>true</static><pose>2.8 3.1 0.25 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.7 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.7 0.5</size></box></geometry>
          <material><ambient>0.30 0.35 0.75 1</ambient><diffuse>0.38 0.45 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_01">
      <static>true</static><pose>-0.9 1.7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.75 0.70 0.12 1</ambient><diffuse>0.95 0.90 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_02">
      <static>true</static><pose>4.1 1.4 0.325 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>0.65</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.15 0.65 0.35 1</ambient><diffuse>0.18 0.82 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="overview_camera">
        <pose>8 -10 10 0 0.65 2.35</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
